/**
 * 재단법인 학성장학회
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haksung",
	"compatibility_date": "2026-10-06",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	// 사용자 도메인 연결 전까지 haksung.hyowoog.workers.dev 주소를 쓴다
	"workers_dev": true,
	// 버전별 미리보기 주소는 운영 D1/R2를 그대로 쓰므로 열어 두지 않는다
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "haksung",
			"database_id": "06915c42-a3a7-44e2-9c34-60334fca3556",
			// 로컬 개발 DB(.wrangler/state)는 기존 id로 저장돼 있어 그대로 유지한다
			"preview_database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "haksung"
		}
	]
}
